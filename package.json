{
  "name": "solo-founder-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-css.js && next dev",
    "build": "node scripts/gen-css.js && next build",
    "start": "next start",
    "lint": "next lint",
    "setup-db": "node scripts/setup-db.js",
    "migrate": "node scripts/migrate-to-aicompany.js",
    "seed": "node scripts/seed-aicompany.js",
    "seed-old": "node scripts/seed-data.js",
    "backend": "cd backend && npm run dev",
    "desktop": "node main.js",
    "electron": "electron electron-main.js",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win32": "npm run build && electron-builder --win --ia32",
    "package:mac": "npm run build && electron-builder --mac --x64",
    "package:mac-arm": "npm run build && electron-builder --mac --arm64",
    "package:linux": "npm run build && electron-builder --linux --x64",
    "package:all": "npm run build && electron-builder --win --mac --linux",
    "package:all-arm": "npm run build && electron-builder --win --mac --linux --arm64",
    "gen-icons": "node build/gen-icons.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "aicompany": "^0.3.17",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "next": "14.2.29",
    "open": "^10.1.0",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.23",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3"
  },
  "main": "electron-main.js"
}
